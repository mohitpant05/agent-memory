# Linux defaults. Copied to .env on first run; edit that, not this.
MEM0_USER_ID=user
MEM0_COLLECTION=mem0_shared

MEM0_QDRANT_URL=http://127.0.0.1:6333
MEM0_OLLAMA_URL=http://127.0.0.1:11434

# ---- exposure (SECURITY) ----
# The MCP server has NO inbound authentication. Anyone who can reach this port
# gets full read/write/delete on every memory. Pick one:
#   127.0.0.1  -> loopback only; reach it over an SSH tunnel  (default, safest)
#   100.x.y.z  -> a Tailscale IP; reachable on the tailnet only
# The installer REFUSES to proceed with 0.0.0.0.
MEM0_HOST=127.0.0.1
MEM0_PORT=8081
MEM0_TRANSPORT=streamable-http

# ---- models ----
# The extraction model MUST be a non-thinking instruct model - see patches/.
# qwen2.5:3b-instruct ~1.9GB  fits a 4GB GPU
# qwen2.5:7b-instruct ~4.7GB  needs ~8GB VRAM
MEM0_PROVIDER=ollama
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_MODEL=qwen2.5:3b-instruct
MEM0_EMBED_PROVIDER=ollama
# On a small-VRAM GPU the embedder and the LLM cannot both stay resident and
# Ollama evicts one per call. The installer builds a CPU-pinned variant when the
# name ends in -cpu, leaving the whole GPU to the extraction model.
MEM0_EMBED_MODEL=bge-m3-cpu
MEM0_EMBED_DIMS=1024

MEM0_ENABLE_GRAPH=false
MEM0_LOG_LEVEL=INFO

# Rewritten by the installer to this machine's absolute path.
MEM0_FACT_PROMPT_FILE=

# Reviewed upstream commit. Re-review before moving this.
MEM0_MCP_REF=a4f538afc60ca13a9f5975e6a11fd36e578393ac
